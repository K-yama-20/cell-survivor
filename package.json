{
  "name": "micro-survivor",
  "private": true,
  "version": "0.1.0",
  "description": "A code-driven 2D auto-survival game controlled with Python.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "prepare:pyodide": "node scripts/copy-pyodide-assets.mjs",
    "dev": "npm run prepare:pyodide && vite",
    "build": "npm run prepare:pyodide && tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:electron-spike": "node scripts/verify-electron-spike.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "phaser": "^3.90.0",
    "pyodide": "314.0.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.34.1",
    "vite": "^8.3.3",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.3"
  }
}
